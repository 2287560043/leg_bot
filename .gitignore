# Local editor settings
.vscode/
*.code-workspace
*.swp
*.swo
*~
.DS_Store

# Build directories (firmware and host tests)
/build*/
/cmake-build-*/

# CMake/Ninja files from accidental in-source builds
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/compile_commands.json
/build.ninja
/rules.ninja
/.ninja_deps
/.ninja_log

# Compiler/linker outputs
*.o
*.obj
*.a
*.elf
*.hex
*.bin
*.map
*.su

# Ozone per-user state and debug logs; keep shared *.jdebug projects
*.jdebug.user
*.jdebug.user.*
*.jdebug.log
*.jlinklog
/logs/

# Python caches
__pycache__/
*.py[cod]

tests/
